# SJinn AI — основной провайдер для генерации изображений и видео
# Получить ключ: https://sjinn.ai
SJINN_API_KEY=your-sjinn-api-key-here

# FFmpeg Cloud API — облачный FFmpeg (опционально, можно использовать локальный)
# Получить ключ: https://api.ffmpeg-api.com
FFMPEG_API_KEY=your-base64-encoded-key-here

# fal.ai — альтернативный провайдер (planned, пока не используется)
# Получить ключ: https://fal.ai
FAL_KEY=

# Supabase — очередь задач и ассеты
# Dashboard: https://supabase.com/dashboard/project/txckerrkubbvmzlionjf
SUPABASE_URL=https://txckerrkubbvmzlionjf.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here
# Service Role Key — нужен для upload-asset.sh (Storage uploads)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
