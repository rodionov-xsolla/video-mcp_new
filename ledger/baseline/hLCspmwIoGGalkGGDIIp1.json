    {
      "id": "8290654d-86a9-4cbd-bce3-99328496bb1b",
      "name": "Execute a SQL query",
      "parameters": {
        "operation": "executeQuery",
        "options": {},
        "query": "SELECT EXISTS (\n  -- overtime wait\n  SELECT 1 FROM public.xsolla_ai_posted_content_base\n  WHERE status = 'wait moderation'\n    AND COALESCE(status_updated_at, created_at) <= NOW() - INTERVAL '48 hours'\n  \n  UNION ALL\n  \n  -- overtime approved  \n  SELECT 1 FROM public.xsolla_ai_posted_content_base\n  WHERE status = 'approved'\n    AND COALESCE(status_updated_at, created_at) <= NOW() - INTERVAL '48 hours'\n  \n  UNION ALL\n  \n  -- ready to post\n  SELECT 1 \n  FROM public.xsolla_ai_posted_content_base p\n  LEFT JOIN (\n    SELECT channel_id, MAX(status_updated_at) AS last_posted_at\n    FROM public.xsolla_ai_posted_content_base\n    WHERE status = 'posted'\n    GROUP BY channel_id\n  ) lp USING (channel_id)\n  JOIN public.post_schedule s ON lower(p.country) = lower(s.country)\n  WHERE p.status = 'approved'\n    AND p.channel_id IS NOT NULL\n    AND NOT EXISTS (\n      SELECT 1 FROM public.xsolla_ai_posted_content_base \n      WHERE status = 'posting' AND channel_id = p.channel_id\n    )\n    AND (lp.last_posted_at IS NULL OR lp.last_posted_at <= NOW() - INTERVAL '60 minutes')\n    AND EXTRACT(ISODOW FROM (NOW() AT TIME ZONE s.tz))::int = ANY(s.weekdays)\n    AND (\n      (s.start_local <= s.end_local \n       AND (NOW() AT TIME ZONE s.tz)::time >= s.start_local\n       AND (NOW() AT TIME ZONE s.tz)::time < s.end_local)\n      OR\n      (s.start_local > s.end_local \n       AND ((NOW() AT TIME ZONE s.tz)::time >= s.start_local\n            OR (NOW() AT TIME ZONE s.tz)::time < s.end_local))\n    )\n) AS has_work;"
      },
